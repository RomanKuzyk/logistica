PG_BIND=0.0.0.0:8089
PG_PRINTER_IP=192.168.123.119
PG_PRINTER_MODEL=QL-810W
PG_DPI=300
# Для QL-810W + DK-22223 (continuous tape) фізичні 50×30мм виходять так:
# - принтер додає мінімальні фізичні поля/подачу для різу (~3мм зверху + ~3мм знизу)
# - тому 30мм контенту дає ~35–36мм фізичного відрізу
# Практичний профіль: 24мм контенту + мінімальні поля => ~30мм фізичного відрізу.
PG_LABEL_HEIGHT_MM=24
# label id for brother_ql (continuous tape width). для DK-22223 (50мм) це має бути `50`.
PG_BROTHER_LABEL=50
PG_DRY_RUN=0
# Режим відрізу:
# - autocut: стандартний (ESC i M + cut every 1)
# - cut_at_end: без autocut, тільки "cut at end" (часто дає менше зайвої подачі)
PG_CUT_MODE=cut_at_end
#
# Додаткова подача стрічки (ESC i d) у dots (@300dpi).
# brother_ql для endless label=50 ставить 35 dots (~3мм). Можна зменшити до 0.
PG_FEED_MARGIN_DOTS=0
#
# Якщо ще лишається "зайва довжина" після різу — тимчасовий хак:
# друкуємо трохи меншу висоту зображення.
PG_CUT_COMPENSATION_MM=0
#
# Тестовий "crop" рендера PDF (мм). Використовувати обережно — може обрізати контент.
PG_CROP_TOP_MM=0
PG_CROP_BOTTOM_MM=0
#
# Trim whitespace навколо контенту при рендері PDF.
# Якщо фон не чисто білий (антиаліас/сірий), підкрути threshold нижче.
PG_TRIM_THRESHOLD=245
PG_TRIM_PAD_PX=2
#
# Fit mode:
# - width_fill: як зараз — спочатку масштабуємо по ширині 50мм, потім fit по висоті
# - contain: пропорційно вписуємо в box 50мм×H (без crop), може додати поля з боків
#
# Рекомендація для штрихкодів: `width_fill` + білі поля з боків через `PG_SIDE_PADDING_MM`.
# Якщо треба зробити максимально вузько — став `PG_FIT_MODE=contain`.
PG_FIT_MODE=width_fill
PG_SIDE_PADDING_MM=2
#
# Вертикальний fit контенту у 30мм:
# - center_pad: як зараз (додає білі поля якщо scaled.height < out_h)
# - stretch: розтягує по Y до 30мм (не чіпає X)
PG_VERTICAL_FIT=stretch
# Опціонально. Якщо не задано — буде tcp://PG_PRINTER_IP:9100
# PG_PRINTER_URI=tcp://192.168.123.119:9100
